{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C++: Build active file",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-O2",
        "-I${workspaceFolder}/include",
        "${file}",
        "-o",
        "${workspaceFolder}/build/${fileBasenameNoExtension}.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Compiles the currently open .cpp file → build/<filename>.exe",
      "problemMatcher": "$gcc"
    },
    {
      "label": "C++: Run active file",
      "type": "shell",
      "command": "& '${workspaceFolder}/build/${fileBasenameNoExtension}.exe'",
      "detail": "Runs build/<filename>.exe",
      "problemMatcher": []
    },
    {
      "label": "C++: Build and run active file",
      "type": "shell",
      "dependsOn": "C++: Build active file",
      "dependsOrder": "sequence",
      "command": "& '${workspaceFolder}/build/${fileBasenameNoExtension}.exe'",
      "detail": "Builds and runs the currently open .cpp file",
      "problemMatcher": []
    },
    {
      "label": "C++: Build entire project",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/scripts/build.py", "--debug"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": "build",
      "detail": "Builds the six independent pricing executables",
      "problemMatcher": "$gcc"
    },
    {
      "label": "C++: Validate project",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/tests/test_pricing.py", "-v"],
      "options": {"cwd": "${workspaceFolder}"},
      "detail": "Runs numerical validation against the six executables",
      "problemMatcher": []
    }
  ]
}
