{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C++: Build active file",
      "type": "shell",
      "command": "D:/Apps/MinGW-w64/ucrt64/bin/g++.exe",
      "args": [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-g",
        "-I${workspaceFolder}/include",
        "${file}",
        "-o",
        "${workspaceFolder}/build/${fileBasenameNoExtension}.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Compiles the currently open .cpp file → build/<filename>.exe",
      "problemMatcher": "$gcc"
    },
    {
      "label": "C++: Run active file",
      "type": "shell",
      "command": "& '${workspaceFolder}/build/${fileBasenameNoExtension}.exe'",
      "detail": "Runs build/<filename>.exe",
      "problemMatcher": []
    },
    {
      "label": "C++: Build and run active file",
      "type": "shell",
      "dependsOn": "C++: Build active file",
      "dependsOrder": "sequence",
      "command": "& '${workspaceFolder}/build/${fileBasenameNoExtension}.exe'",
      "detail": "Builds and runs the currently open .cpp file",
      "problemMatcher": []
    },
    {
      "label": "C++: Build entire project",
      "type": "shell",
      "command": "D:/Apps/MinGW-w64/ucrt64/bin/g++.exe",
      "args": [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-g",
        "-I${workspaceFolder}/include",
        "${workspaceFolder}/src/black_scholes_european_option.cpp",
        "${workspaceFolder}/src/monte_carlo_european_option.cpp",
        "${workspaceFolder}/src/main.cpp",
        "-o",
        "${workspaceFolder}/build/option_pricing.exe"
      ],
      "group": "build",
      "detail": "Compiles the main thesis project files → build/option_pricing.exe",
      "problemMatcher": "$gcc"
    },
    {
      "label": "C++: Run entire project",
      "type": "shell",
      "command": "& '${workspaceFolder}/build/option_pricing.exe'",
      "detail": "Runs build/option_pricing.exe",
      "problemMatcher": []
    }
  ]
}